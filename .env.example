# Koneksi PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cms_portal_berita?schema=public"
# Batasi pool koneksi (isi 1 bila memakai `prisma dev`; kosongkan untuk PostgreSQL biasa)
DATABASE_POOL_MAX=""

# Better Auth: secret minimal 32 karakter acak (mis. `openssl rand -base64 32`)
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
BETTER_AUTH_URL="http://localhost:3000"

# Nama bawaan sebelum Identitas Website diisi
NEXT_PUBLIC_APP_NAME="Portal Berita"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Jakarta"

# Supabase Storage untuk file unggahan (wajib di Vercel; kosongkan untuk memakai folder storage/)
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET="media"
